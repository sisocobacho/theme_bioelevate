<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="theme_homepage_content" model="theme.ir.ui.view">
        <field name="name">Mital Theme Homepage Content</field>
        <field name="inherit_id" ref="website.homepage"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='wrap']" position="replace">
                <div id="wrap" class="oe_structure">

                    <!-- Hero Section -->
                    <section class="s_text_block o_cc o_cc5 pt128 pb128 o_colored_level"
                        data-snippet="s_text_block" data-name="Hero">
                        <div class="container">
                            <div class="row align-items-end">
                                <div class="col-lg-7 pb32 o_colored_level">
                                    <p class="mb-3">
                                        <span class="badge d-inline-flex align-items-center gap-2 fw-normal"
                                            style="background-color: rgba(var(--color1-rgb), 0.08); color: var(--color1); border: 1px solid rgba(var(--color1-rgb), 0.2); padding: 5px 14px; border-radius: 100px; font-size: 12px; letter-spacing: 0.4px;">
                                            <span style="display: inline-block; width: 6px; height: 6px; border-radius: 50%; background-color: var(--color1);"></span>
                                            For licensed clinics &amp; professional distributors
                                        </span>
                                    </p>
                                    <h1>Premium peptide products for clinical <em>professionals.</em></h1>
                                    <p class="lead mb-4" style="font-weight: 300; max-width: 480px;">Mital Universal supplies high-purity peptide products to licensed clinics, medical professionals, and qualified distributors across the US, Latin America, and the Caribbean.</p>
                                    <p>
                                        <a class="btn btn-primary btn-lg o_translate_inline" href="/shop">Browse Products →</a>
                                        <a class="btn btn-outline-light btn-lg o_translate_inline ms-2" href="#contact-section">Get in Touch</a>
                                    </p>
                                </div>
                                <div class="col-lg-5 o_colored_level">
                                    <div class="card o_cc o_cc4" style="border: 1px solid rgba(255,255,255,0.1); border-radius: 16px;">
                                        <div class="card-body p-4">
                                            <p class="text-uppercase small fw-semibold mb-3"
                                                style="letter-spacing: 1.4px; color: rgba(0,0,0,0.38);">Quality Standards — Every Lot</p>
                                            <div class="d-flex justify-content-between py-2" style="border-bottom: 1px solid rgba(0,0,0,0.05);">
                                                <span style="font-size: 13.5px; color: rgba(0,0,0,0.62);">Purity (HPLC)</span>
                                                <span class="text-primary fw-medium" style="font-size: 13px;">≥ 99%</span>
                                            </div>
                                            <div class="d-flex justify-content-between py-2" style="border-bottom: 1px solid rgba(0,0,0,0.05);">
                                                <span style="font-size: 13.5px; color: rgba(0,0,0,0.62);">Endotoxin</span>
                                                <span class="fw-medium" style="font-size: 13px;">≤ 1 EU/mg</span>
                                            </div>
                                            <div class="d-flex justify-content-between py-2" style="border-bottom: 1px solid rgba(0,0,0,0.05);">
                                                <span style="font-size: 13.5px; color: rgba(0,0,0,0.62);">Identity Testing</span>
                                                <span class="fw-medium" style="font-size: 13px;">MS Confirmed</span>
                                            </div>
                                            <div class="d-flex justify-content-between py-2" style="border-bottom: 1px solid rgba(0,0,0,0.05);">
                                                <span style="font-size: 13.5px; color: rgba(0,0,0,0.62);">Certificate of Analysis</span>
                                                <span class="text-primary fw-medium" style="font-size: 13px;">Included</span>
                                            </div>
                                            <div class="d-flex justify-content-between py-2" style="border-bottom: 1px solid rgba(0,0,0,0.05);">
                                                <span style="font-size: 13.5px; color: rgba(0,0,0,0.62);">Storage</span>
                                                <span class="fw-medium" style="font-size: 13px;">2–8°C Cold-Chain</span>
                                            </div>
                                            <div class="d-flex justify-content-between py-2">
                                                <span style="font-size: 13.5px; color: rgba(0,0,0,0.62);">Access</span>
                                                <span class="fw-medium" style="font-size: 13px;">B2B · Verified Only</span>
                                            </div>
                                            <p class="mt-3 mb-0 small"
                                                style="font-size: 12px; color: rgba(0,0,0,0.38); line-height: 1.55;">
                                                All products are accompanied by a lot-specific Certificate of Analysis. Access requires professional credentials.
                                            </p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- Trust Strip -->
                    <section class="s_text_block o_cc o_cc2 pt24 pb24 o_colored_level"
                        data-snippet="s_text_block" data-name="Trust Strip">
                        <div class="container">
                            <div class="row justify-content-between align-items-center g-3">
                                <div class="col d-flex align-items-center gap-2 o_colored_level">
                                    <div class="d-flex align-items-center justify-content-center"
                                        style="width: 32px; height: 32px; border-radius: 8px; background: rgba(0,0,0,0.05); flex-shrink: 0;">
                                        <i class="fa fa-flash" style="font-size: 14px;"></i>
                                    </div>
                                    <span class="small" style="color: rgba(0,0,0,0.62);">≥ 99% purity, every lot</span>
                                </div>
                                <div class="col d-flex align-items-center gap-2 o_colored_level">
                                    <div class="d-flex align-items-center justify-content-center"
                                        style="width: 32px; height: 32px; border-radius: 8px; background: rgba(0,0,0,0.05); flex-shrink: 0;">
                                        <i class="fa fa-file-text-o" style="font-size: 14px;"></i>
                                    </div>
                                    <span class="small" style="color: rgba(0,0,0,0.62);">Lot-specific COA included</span>
                                </div>
                                <div class="col d-flex align-items-center gap-2 o_colored_level">
                                    <div class="d-flex align-items-center justify-content-center"
                                        style="width: 32px; height: 32px; border-radius: 8px; background: rgba(0,0,0,0.05); flex-shrink: 0;">
                                        <i class="fa fa-snowflake-o" style="font-size: 14px;"></i>
                                    </div>
                                    <span class="small" style="color: rgba(0,0,0,0.62);">Cold-chain delivery (2–8°C)</span>
                                </div>
                                <div class="col d-flex align-items-center gap-2 o_colored_level">
                                    <div class="d-flex align-items-center justify-content-center"
                                        style="width: 32px; height: 32px; border-radius: 8px; background: rgba(0,0,0,0.05); flex-shrink: 0;">
                                        <i class="fa fa-globe" style="font-size: 14px;"></i>
                                    </div>
                                    <span class="small" style="color: rgba(0,0,0,0.62);">US · LATAM · Caribbean</span>
                                </div>
                                <div class="col d-flex align-items-center gap-2 o_colored_level">
                                    <div class="d-flex align-items-center justify-content-center"
                                        style="width: 32px; height: 32px; border-radius: 8px; background: rgba(0,0,0,0.05); flex-shrink: 0;">
                                        <i class="fa fa-lock" style="font-size: 14px;"></i>
                                    </div>
                                    <span class="small" style="color: rgba(0,0,0,0.62);">Verified professionals only</span>
                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- About Section -->
                    <section class="s_text_block o_cc o_cc1 pt96 pb96 o_colored_level"
                        data-snippet="s_text_block" data-name="About Mital Universal">
                        <div class="container">
                            <div class="row align-items-center g-5">
                                <div class="col-lg-6 o_colored_level">
                                    <p class="text-uppercase small fw-semibold mb-3"
                                        style="letter-spacing: 1.6px; color: rgba(0,0,0,0.38);">About Mital Universal</p>
                                    <h2>Quality you can<br/>count on.</h2>
                                    <p class="text-muted" style="font-size: 15px; line-height: 1.6; max-width: 480px; margin-top: 14px;">
                                        We supply peptide products exclusively to licensed medical professionals and qualified distributors. Every product leaves our facility with verified purity data, cold-chain packaging, and full documentation.
                                    </p>
                                    <p class="text-muted" style="font-size: 15px; line-height: 1.6; max-width: 480px; margin-top: 14px;">
                                        Our catalog covers metabolic health, tissue recovery, hormonal optimization, anti-aging, and neurological support — in injectable vials, oral capsules, and combination blends.
                                    </p>
                                </div>
                                <div class="col-lg-6 o_colored_level">
                                    <div class="row g-3">
                                        <div class="col-6">
                                            <div class="border rounded p-3 text-center bg-light">
                                                <div class="h2 text-primary fw-bold mb-1" style="font-family: serif;">60+</div>
                                                <p class="small text-muted mb-0">Peptide compounds across 3 formats</p>
                                            </div>
                                        </div>
                                        <div class="col-6">
                                            <div class="border rounded p-3 text-center bg-light">
                                                <div class="h2 text-primary fw-bold mb-1" style="font-family: serif;">99%</div>
                                                <p class="small text-muted mb-0">Minimum purity on every product</p>
                                            </div>
                                        </div>
                                        <div class="col-6">
                                            <div class="border rounded p-3 text-center bg-light">
                                                <div class="h2 text-primary fw-bold mb-1" style="font-family: serif;">3</div>
                                                <p class="small text-muted mb-0">Product formats: vials, capsules, blends</p>
                                            </div>
                                        </div>
                                        <div class="col-6">
                                            <div class="border rounded p-3 text-center bg-light">
                                                <div class="h2 text-primary fw-bold mb-1" style="font-family: serif;">US+</div>
                                                <p class="small text-muted mb-0">Serving US, LATAM &amp; Caribbean markets</p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- Contact Section -->
                    <section class="s_text_block o_cc o_cc2 pt96 pb96 o_colored_level"
                        data-snippet="s_text_block" data-name="Contact Us"
                        id="contact-section">
                        <div class="container">
                            <div class="row g-5">
                                <div class="col-lg-5 o_colored_level">
                                    <p class="text-uppercase small fw-semibold mb-3"
                                        style="letter-spacing: 1.6px; color: rgba(0,0,0,0.38);">Get in Touch</p>
                                    <h2>Ready to work<br/>with us?</h2>
                                    <p class="text-muted" style="font-size: 15px; line-height: 1.65; margin-bottom: 32px;">
                                        Reach out to discuss your product needs, minimum orders, pricing, or distribution opportunities. We respond within 1 business day.
                                    </p>
                                    <div class="d-flex mb-4">
                                        <div class="flex-shrink-0 me-3">
                                            <div class="d-flex align-items-center justify-content-center rounded"
                                                style="width: 38px; height: 38px; background: rgba(0,0,0,0.05);">
                                                <i class="fa fa-cube text-primary" style="font-size: 15px;"></i>
                                            </div>
                                        </div>
                                        <div>
                                            <div class="fw-semibold" style="font-size: 14px;">Orders &amp; Products</div>
                                            <p class="small text-muted mb-1" style="font-size: 13px; line-height: 1.5;">Product availability, pricing, and order placement.</p>
                                            <a href="mailto:orders@mitaluniversal.com" class="small text-primary">orders@mitaluniversal.com</a>
                                        </div>
                                    </div>
                                    <div class="d-flex mb-4">
                                        <div class="flex-shrink-0 me-3">
                                            <div class="d-flex align-items-center justify-content-center rounded"
                                                style="width: 38px; height: 38px; background: rgba(0,0,0,0.05);">
                                                <i class="fa fa-handshake-o text-primary" style="font-size: 15px;"></i>
                                            </div>
                                        </div>
                                        <div>
                                            <div class="fw-semibold" style="font-size: 14px;">Distribution Partners</div>
                                            <p class="small text-muted mb-1" style="font-size: 13px; line-height: 1.5;">Territory availability, wholesale pricing, and partnership inquiries.</p>
                                            <a href="mailto:partners@mitaluniversal.com" class="small text-primary">partners@mitaluniversal.com</a>
                                        </div>
                                    </div>
                                    <div class="d-flex mb-4">
                                        <div class="flex-shrink-0 me-3">
                                            <div class="d-flex align-items-center justify-content-center rounded"
                                                style="width: 38px; height: 38px; background: rgba(0,0,0,0.05);">
                                                <i class="fa fa-file-text-o text-primary" style="font-size: 15px;"></i>
                                            </div>
                                        </div>
                                        <div>
                                            <div class="fw-semibold" style="font-size: 14px;">Documentation &amp; COA</div>
                                            <p class="small text-muted mb-1" style="font-size: 13px; line-height: 1.5;">Certificate of Analysis requests and product documentation.</p>
                                            <a href="mailto:coa@mitaluniversal.com" class="small text-primary">coa@mitaluniversal.com</a>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-lg-6 offset-lg-1 o_colored_level">
                                    <div class="card o_cc o_cc4" style="border-radius: 16px;">
                                        <div class="card-body p-4">
                                            <h4 class="mb-1">Send us a message</h4>
                                            <p class="small text-muted mb-4">We'll get back to you within 1 business day.</p>
                                            <form action="/website/form/" method="post"
                                                enctype="multipart/form-data"
                                                class="o_mark_required"
                                                data-mark="*" data-pre-fill="true"
                                                data-model_name="mail.mail"
                                                data-success-mode="redirect"
                                                data-success-page="/contactus-thank-you"
                                                id="contactForm">
                                                <input type="hidden" class="form-control s_website_form_input"
                                                    name="email_to" value="info@yourcompany.example.com"/>
                                                <div data-name="Field"
                                                    class="s_website_form_field mb-3 col-12 s_website_form_custom s_website_form_required"
                                                    data-type="char">
                                                    <label class="form-label small fw-medium">
                                                        <span class="s_website_form_label_content">Full name</span>
                                                        <span class="s_website_form_mark"> *</span>
                                                    </label>
                                                    <input class="form-control s_website_form_input" type="text"
                                                        name="name" required="1" data-fill-with="name"
                                                        placeholder="John Doe"/>
                                                </div>
                                                <div data-name="Field"
                                                    class="s_website_form_field mb-3 col-12 s_website_form_custom s_website_form_required"
                                                    data-type="char">
                                                    <label class="form-label small fw-medium">
                                                        <span class="s_website_form_label_content">Business name</span>
                                                        <span class="s_website_form_mark"> *</span>
                                                    </label>
                                                    <input class="form-control s_website_form_input" type="text"
                                                        name="company" required="1"
                                                        data-fill-with="commercial_company_name"
                                                        placeholder="Your clinic or organization"/>
                                                </div>
                                                <div data-name="Field"
                                                    class="s_website_form_field mb-3 col-12 s_website_form_model_required"
                                                    data-type="email">
                                                    <label class="form-label small fw-medium">
                                                        <span class="s_website_form_label_content">Email address</span>
                                                        <span class="s_website_form_mark"> *</span>
                                                    </label>
                                                    <input class="form-control s_website_form_input" type="email"
                                                        name="email_from" required="" data-fill-with="email"
                                                        placeholder="you@organization.com"/>
                                                </div>
                                                <div data-name="Field"
                                                    class="s_website_form_field mb-3 col-12 s_website_form_custom"
                                                    data-type="char">
                                                    <label class="form-label small fw-medium">
                                                        <span class="s_website_form_label_content">Inquiry type</span>
                                                    </label>
                                                    <select class="form-control s_website_form_input"
                                                        name="subject">
                                                        <option value="">Select…</option>
                                                        <option>Product availability &amp; pricing</option>
                                                        <option>Distribution partnership</option>
                                                        <option>COA or documentation request</option>
                                                        <option>Order support</option>
                                                        <option>Other</option>
                                                    </select>
                                                </div>
                                                <div data-name="Field"
                                                    class="s_website_form_field mb-3 col-12 s_website_form_custom s_website_form_required"
                                                    data-type="text">
                                                    <label class="form-label small fw-medium">
                                                        <span class="s_website_form_label_content">Message</span>
                                                        <span class="s_website_form_mark"> *</span>
                                                    </label>
                                                    <textarea class="form-control s_website_form_input"
                                                        name="description" required="1"
                                                        placeholder="Tell us what you're looking for…"
                                                        rows="4"></textarea>
                                                </div>
                                                <p class="small mb-3"
                                                    style="font-size: 11.5px; color: rgba(0,0,0,0.38); line-height: 1.55;">
                                                    By submitting this form you confirm you are a licensed medical professional or qualified business representative. Mital Universal does not accept consumer or patient inquiries.
                                                </p>
                                                <div class="s_website_form_submit" data-name="Submit Button">
                                                    <span id="s_website_form_result"/>
                                                    <button type="submit"
                                                        class="btn btn-primary w-100 s_website_form_send">Send Message →</button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>

                </div>
            </xpath>
        </field>
    </record>

</odoo>
