<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <function model="theme.utils" name="enable_view">
            <value eval="'website.template_header_stretch'" />
        </function>

        <record id="theme_header_cta_contact_section" model="theme.ir.ui.view">
            <field name="name">Theme Header CTA Contact Section Link</field>
            <field name="key">theme_bioelevate.theme_header_cta_contact_section</field>
            <field name="inherit_id" ref="website.header_call_to_action"/>
            <field name="arch" type="xml">
                <xpath expr="//section[@data-snippet='s_text_block']//a[1]" position="attributes">
                    <attribute name="href">/#contact-section</attribute>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
