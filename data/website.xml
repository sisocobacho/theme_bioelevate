<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="website.default_website" model="website">
            <field name="name">BioElevate</field>
            <field name="logo" type="base64" file="theme_bioelevate/static/src/img/logo.png" />
        </record>
        <function model="website" name="write">
            <function model="website" name="search" eval="[[('id', '=', ref('website.default_website'))]]" />
            <value eval="{'homepage_url': False}" />
        </function>
        <function model="website.page" name="write">
            <function model="website.page" name="search" eval="[[('website_id', '=', ref('website.default_website')), ('key', '=', 'website.homepage')]]" />
            <value eval="{'url': '/'}" />
        </function>
        <function model="website.menu" name="write">
            <function model="website.menu" name="search" eval="[[('website_id', '=', ref('website.default_website')), ('name', '=', 'Home')]]" />
            <value eval="{'url': '/'}" />
        </function>
    </data>
    <data noupdate="1">
        <record id="website.default_website" model="website">
            <field name="theme_id" ref="base.module_theme_bioelevate" />
        </record>
    </data>
</odoo>
